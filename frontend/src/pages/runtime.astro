---
import AppLayout from "../layouts/AppLayout.astro";
import EmptyState from "../svelte/common/EmptyState.svelte";
import { getApiOrigin } from "../lib/api/config.js";

const origin = getApiOrigin();
---

<AppLayout title="Runtime" breadcrumb={["Runtime"]}>
  <EmptyState
    icon="runtime"
    title="Runtime"
    description="Backend health, listening port, auth state and websocket status appear here. Data comes from GET /api/health — not available yet, the typed client connects in a later phase."
  >
    <p class="endpoint-line">
      API origin: <code>{origin}</code>
    </p>
  </EmptyState>
</AppLayout>

<style>
  .endpoint-line {
    margin: var(--space-3) 0 0;
    color: var(--secondary);
    font-size: 0.8125rem;
  }

  .endpoint-line code {
    padding: 2px var(--space-2);
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--code);
    color: var(--text);
    font-size: 0.8125rem;
  }
</style>