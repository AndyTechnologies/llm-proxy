---
import AppLayout from "../layouts/AppLayout.astro";
import Overview from "../svelte/overview/Overview.svelte";

/**
 * Overview — console landing page. The live dashboard island gathers real
 * values through the typed API clients (runtime health, model registry,
 * workflow store) and refreshes every 10 seconds. It never invents metrics:
 * unavailable values render as "—"/"Unavailable" with an honest reason.
 */
---

<AppLayout title="Overview">
  <header class="page-head">
    <h1>Overview</h1>
    <p>
      Live runtime summary — backend endpoint, model registry state and recent
      workflows, refreshed automatically from the /api surface.
    </p>
  </header>

  <Overview client:load />
</AppLayout>

<style>
  .page-head h1 {
    margin: 0 0 var(--space-2);
    font-size: 1.5rem;
    font-weight: 700;
  }

  .page-head p {
    margin: 0 0 var(--space-6);
    color: var(--secondary);
    max-width: 64ch;
  }
</style>