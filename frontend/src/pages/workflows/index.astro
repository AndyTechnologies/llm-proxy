---
import AppLayout from "../../layouts/AppLayout.astro";
import WorkflowsList from "../../svelte/workflows/WorkflowsList.svelte";

/**
 * Workflow library — the list island owns all data: it talks to the real
 * /api/workflows surface through the typed client (no server-side fetch
 * here), and reports loading/error/empty states honestly. The count lives in
 * the island, so this page renders only the heading shell.
 */
---

<AppLayout title="Workflows" breadcrumb={["Workflows"]}>
  <header class="page-head">
    <h1>Workflows</h1>
    <p>
      Stored workflow definitions with run, log and delete controls — powered
      by the backend workflow API.
    </p>
  </header>

  <WorkflowsList client:load />
</AppLayout>

<style>
  .page-head h1 {
    margin: 0 0 var(--space-2);
    font-size: 1.5rem;
    font-weight: 700;
  }

  .page-head p {
    margin: 0 0 var(--space-6);
    color: var(--secondary);
    max-width: 64ch;
  }
</style>