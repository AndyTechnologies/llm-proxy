---
import AppLayout from "../../layouts/AppLayout.astro";
import EmptyState from "../../svelte/common/EmptyState.svelte";

/**
 * Per-model details. The route is dynamic; the static build emits no pages
 * until model ids can come from the real backend (getStaticPaths stays empty
 * in this phase — no fabricated models). Dev mode serves any :id on demand.
 */
export function getStaticPaths() {
  return [];
}

const { id } = Astro.params;
const modelId = id ?? "unknown";
---

<AppLayout title={modelId} breadcrumb={["Models", modelId]}>
  <EmptyState
    icon="models"
    title={modelId}
    description="Per-model configuration, activation state and backend logs appear here. Data comes from the backend models API — not available yet, the typed client connects in a later phase."
  />
</AppLayout>