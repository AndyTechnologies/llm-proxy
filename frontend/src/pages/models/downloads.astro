---
import AppLayout from "../../layouts/AppLayout.astro";
import EmptyState from "../../svelte/common/EmptyState.svelte";

/**
 * Model downloads. Honest state: there is NO downloads endpoint in the
 * public /api surface (verified against src/routes/api.ts +
 * src/app/server.ts). The gosh download engine (src/downloads/) is
 * backend-internal, so this section shows the "Coming from backend" state
 * instead of inventing an endpoint or data.
 */
---

<AppLayout title="Downloads" breadcrumb={["Models", "Downloads"]}>
  <header class="page-head">
    <h1>Downloads</h1>
  </header>

  <EmptyState
    icon="downloads"
    title="Coming from backend"
    description="Model discovery and gosh downloads are not exposed through the public API yet."
  />
</AppLayout>

<style>
  .page-head h1 {
    margin: 0 0 var(--space-6);
    font-size: 1.5rem;
    font-weight: 700;
  }
</style>