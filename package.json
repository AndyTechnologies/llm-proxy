{
  "name": "weavellm",
  "version": "0.1.0",
  "description": "WeaveLLM — local AI desktop runtime with a visual workflow editor, model management, and an OpenAI-compatible proxy",
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "weavellm": "./dist/main.js"
  },
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:frontend": "astro dev --root frontend",
    "build": "bun build src/main.ts --target=bun --outdir dist",
    "build:frontend": "astro build --root frontend",
    "build:binary": "bun run scripts/build-binary.ts",
    "build:binaries": "bun run scripts/build-binaries.ts",
    "start": "bun run build:frontend && bun run src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "eslint --fix ."
  },
  "keywords": [
    "llm",
    "gateway",
    "proxy",
    "openai",
    "llama",
    "llama.cpp",
    "llama-server",
    "workflow",
    "rag",
    "desktop",
    "ai"
  ],
  "author": {
    "name": "AndyTechnologies",
    "email": "garciandy579@gmail.com",
    "url": "https://github.com/AndyTechnologies"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndyTechnologies/llm-proxy.git"
  },
  "homepage": "https://github.com/AndyTechnologies/llm-proxy",
  "bugs": {
    "url": "https://github.com/AndyTechnologies/llm-proxy/issues"
  },
  "engines": {
    "bun": ">=1.4",
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/svelte": "9.0.1",
    "@xyflow/svelte": "1.6.6",
    "astro": "7.3.2",
    "svelte": "5.57.0",
    "yaml": "2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bun": "^1.4.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.9.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.69.0"
  }
}