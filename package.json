{
  "name": "llm-proxy",
  "version": "0.1.0",
  "description": "Intelligent LLM gateway with configurable chain orchestration, OpenAI-compatible API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "llm-proxy": "./dist/index.js"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir dist",
    "build:binary": "bun build src/index.ts --compile --outfile dist/llm-proxy",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "eslint --fix ."
  },
  "keywords": [
    "llm",
    "gateway",
    "proxy",
    "openai",
    "llama",
    "orcestration"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "bun": ">=1.4"
  },
  "dependencies": {
    "express": "^5.2.1",
    "helmet": "^8.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/express": "^5.0.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.9.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.69.0"
  }
}
