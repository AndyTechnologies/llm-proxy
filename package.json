{
  "name": "llm-proxy",
  "version": "0.1.0",
  "description": "Intelligent LLM gateway with configurable chain orchestration, OpenAI-compatible API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "llm-proxy": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "eslint --fix ."
  },
  "keywords": [
    "llm",
    "gateway",
    "proxy",
    "openai",
    "llama",
    "orcestration"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "helmet": "^8.0.0",
    "js-yaml": "^4.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.5.0",
    "eslint": "^10.9.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
