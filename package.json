{
  "name": "llm-proxy",
  "version": "0.1.0",
  "description": "Intelligent LLM gateway with configurable chain orchestration, OpenAI-compatible API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "llm-proxy": "./dist/index.js"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir dist",
    "build:ui": "bunx vite build src/ui-svelte && bun run scripts/measure-bundle.ts",
    "build:binary": "bun build src/index.ts --compile --outfile dist/llm-proxy --asset dist/ui",
    "smoke:binary": "bun run scripts/binary-smoke.ts",
    "build:binaries": "bun run scripts/build-binaries.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "e2e-server": "bun run e2e/e2e-server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "eslint --fix ."
  },
  "keywords": [
    "llm",
    "gateway",
    "proxy",
    "openai",
    "llama",
    "llama.cpp",
    "llama-server",
    "orchestration",
    "ai",
    "api"
  ],
  "author": {
    "name": "AndyTechnologies",
    "email": "garciandy579@gmail.com",
    "url": "https://github.com/AndyTechnologies"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndyTechnologies/llm-proxy.git"
  },
  "homepage": "https://github.com/AndyTechnologies/llm-proxy",
  "bugs": {
    "url": "https://github.com/AndyTechnologies/llm-proxy/issues"
  },
  "engines": {
    "bun": ">=1.4"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.44",
    "@ai-sdk/provider": "4.0.10",
    "ai": "7.0.93",
    "express": "^5.2.1",
    "helmet": "^8.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.2.4",
    "@types/bun": "^1.4.0",
    "@types/express": "^5.0.0",
    "@types/jsdom": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.9.1",
    "jsdom": "^25.0.1",
    "svelte": "^5.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.0.0"
  }
}
