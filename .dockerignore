# Exclude from the Docker build context (S3.3) so node_modules/dist/.llm-proxy
# never bloat the image or get baked in — llama-server, GGUF models and the
# preset dir are mounted as external volumes at runtime.
node_modules/
dist/
.llm-proxy/
.codegraph/
*.log
.git/
.gitignore
openspec/
.atl/
*.md
